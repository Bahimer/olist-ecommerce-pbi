{
  "name": "Olist Pro",
  "dataColors": [
    "#1F6FEB",
    "#13A89E",
    "#F2A541",
    "#E4572E",
    "#7B61FF",
    "#0B2545",
    "#8D99AE",
    "#56C596",
    "#FF8FAB",
    "#3A86FF"
  ],
  "foreground": "#0B2545",
  "foregroundNeutralSecondary": "#5B6B82",
  "foregroundNeutralTertiary": "#8D99AE",
  "background": "#FFFFFF",
  "backgroundLight": "#F3F5F9",
  "backgroundNeutral": "#E3E8EF",
  "tableAccent": "#1F6FEB",
  "good": "#13A89E",
  "neutral": "#F2A541",
  "bad": "#E4572E",
  "maximum": "#1F6FEB",
  "center": "#9EC5FE",
  "minimum": "#E8F0FE",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5B6B82"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "transparency": 88,
            "position": "Outer",
            "preset": "BottomRight",
            "shadowBlur": 8,
            "shadowDistance": 2
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 12,
            "bold": true,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontSize": 9,
            "titleColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F6"
              }
            },
            "gridlineStyle": "dotted"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontSize": 9,
            "position": "Top"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "fontSize": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5B6B82"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E8EF"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    }
  }
}