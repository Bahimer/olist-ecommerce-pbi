		isNameInferred
		sourceColumn: [AnnéeMois]

	partition DimDate = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2016,1,1), DATE(2019,12,31)),
				    "Année", YEAR([Date]),
				    "NuméroMois", MONTH([Date]),
				    "Mois", FORMAT([Date], "MMMM"),
				    "MoisAbrégé", FORMAT([Date], "MMM"),
				    "NuméroTrimestre", ROUNDUP(MONTH([Date])/3,0),
				    "Trimestre", "T" & ROUNDUP(MONTH([Date])/3,0),
				    "Jour", DAY([Date]),
				    "JourSemaine", FORMAT([Date], "dddd"),
				    "NuméroJourSemaine", WEEKDAY([Date], 2),
				    "AnnéeMois", FORMAT([Date], "YYYY-MM")
				)

